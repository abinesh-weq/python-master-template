# Application
APP_NAME="WeQ Backend API"
APP_VERSION="1.0.0"
DEBUG=false

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=weq_db

# JWT
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — accepted formats:
#   ALLOWED_ORIGINS=*                               (wildcard)
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200  (comma-separated)
#   ALLOWED_ORIGINS=["http://localhost:3000"]        (JSON array)
ALLOWED_ORIGINS=*

# OTP
OTP_EXPIRE_MINUTES=5

# Default Roles (seeded via Alembic)
DEFAULT_USER_ROLE=ROLE_USER
DEFAULT_ADMIN_ROLE=ROLE_ADMIN

# Application
APP_NAME="WeQ Backend API"
APP_VERSION="1.0.0"
DEBUG=true

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=blueprint-backend

# Security
JWT_SECRET_KEY=94b791557088b94874f67623916962f928a38ca8a6496924f0c9044b7454238e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_REGEX="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$"

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# OTP
OTP_EXPIRE_MINUTES=5

# Authentication & Authorization
# Set to 0/false for local development to bypass JWT validation and RBAC authorization
# When disabled, all endpoints are fully accessible without credentials
# Example: AUTH_ENABLED=0 (disabled for dev), AUTH_ENABLED=1 (enabled for production)
AUTH_ENABLED=1

# Default Roles (seeded via Alembic)
DEFAULT_USER_ROLE=user
DEFAULT_ADMIN_ROLE=admin
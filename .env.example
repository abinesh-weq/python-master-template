# Application
APP_NAME="WeQ Backend API"
APP_VERSION="1.0.0"
DEBUG=true

# Environment Configuration
ENV=development
AWS_REGION=ap-south-1
SSM_PARAM_NAME=""

# Database (MySQL) - For Development Only
# Production uses SSM Parameter Store
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=python-master

# SSM Database Configuration (Production)
DATABASE_URL=jdbc:mysql://your-database-host:3306/your-database-name
DATABASE_USER=your-db-username
DATABASE_PASSWORD=your-db-password

# Security
JWT_SECRET_KEY=94b791557088b94874f67623916962f928a38ca8a6496924f0c9044b7454238e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_REGEX="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$"

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# OTP
OTP_EXPIRE_MINUTES=5

# Authentication & Authorization
# Set to 0/false for local development to bypass JWT validation and RBAC authorization
# When disabled, all endpoints are fully accessible without credentials
# Example: AUTH_ENABLED=0 (disabled for dev), AUTH_ENABLED=1 (enabled for production)
AUTH_ENABLED=1

# Default Roles (seeded via Alembic)
DEFAULT_USER_ROLE=user
DEFAULT_ADMIN_ROLE=admin

# Storage Configuration
DEFAULT_STORAGE_PROVIDER=LOCAL  # LOCAL, S3, or GCS
LOCAL_STORAGE_PATH=data/uploads
LOCAL_STORAGE_URL=/static/uploads

# AWS S3 Configuration (Production)
S3_BUCKET_NAME=weq-prod-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
ENCRYPTION=AES256
PUBLIC_ACCESS=false

# SSM Secrets (Production - these are loaded from WEQ_BACKEND_SECRETS parameter)
SECRET_KEY=your-jwt-signing-secret-key
GOOGLE_KEY=your-google-api-key
CLIENT_ID=your-oauth-client-id
CLIENT_SECRET=your-oauth-client-secret
GOOGLE_CLIENT_CUSTOMER_ID=your-google-client-customer-id
GOOGLE_CLIENT_CUSTOMER_SECRET=your-google-client-customer-secret
KYC_REQUEST_USERNAME=your-kyc-service-username
KYC_REQUEST_PASSWORD=your-kyc-service-password
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
CLIENT_ANDROID_ID=your-android-client-id
CLIENT_IOS_ID=your-ios-client-id
HOST_ANDROID_ID=your-android-host-id
HOST_IOS_ID=your-ios-host-id
OTP_KEY=your-otp-secret-key

# GCS Configuration (if using GCS)
GCS_BUCKET=weq-gcs-bucket
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_PATH=path/to/service-account.json

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
 
# OTP Storage Type
OTP_STORAGE_TYPE=REDIS
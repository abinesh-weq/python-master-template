# Application
APP_NAME="WeQ Backend API"
APP_VERSION="1.0.0"
DEBUG=true

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=blueprint-backend

# Security
JWT_SECRET_KEY=94b791557088b94874f67623916962f928a38ca8a6496924f0c9044b7454238e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_REGEX="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$"

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# OTP
OTP_EXPIRE_MINUTES=5

# Default Roles (seeded via Alembic)
DEFAULT_USER_ROLE=ROLE_USER
DEFAULT_ADMIN_ROLE=ROLE_ADMIN
AUDIT_LOG_ENABLED=True
# Application
APP_NAME="WeQ Backend API"
APP_VERSION="1.0.0"
DEBUG=true

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=blueprint-backend

# Security
JWT_SECRET_KEY=01a948c5f50dc8ae626b2bbebae3ff8a5410c3133cc7fd72ae44ed9bc39304e9dda0cc1472967a02f641f1fd4de9f31020830903d10a926bc8ed1d237e8e7e36
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_REGEX="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$"

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# OTP
OTP_EXPIRE_MINUTES=5

# Authentication & Authorization (set to 0/false for local dev to bypass JWT and RBAC)
AUTH_ENABLED=0

# Default Roles (seeded via Alembic)
DEFAULT_USER_ROLE=user
DEFAULT_ADMIN_ROLE=admin
AUDIT_LOG_ENABLED=True